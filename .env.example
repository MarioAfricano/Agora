# Copy this file to .env and fill in the real values. Never commit .env.

# PostgreSQL. Use only letters and digits in the password: it is part of the database URL.
POSTGRES_USER=agora
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agora

# IGDB API (Twitch OAuth client credentials): https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Signs the session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
